{
  "name": "@healthicons/react",
  "description": "Health Icons as React components. Free, open source health icons from healthicons.org.",
  "version": "1.2.0",
  "license": "CC0-1.0",
  "homepage": "https://healthicons.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolvetosavelives/healthicons.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/resolvetosavelives/healthicons/issues",
  "keywords": [
    "icons",
    "health",
    "healthicons",
    "svg",
    "medical",
    "react"
  ],
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
